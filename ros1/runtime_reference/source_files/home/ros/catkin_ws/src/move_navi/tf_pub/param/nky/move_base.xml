<launch>
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find tf_pub)/param/nky/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find tf_pub)/param/nky/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find tf_pub)/param/nky/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find tf_pub)/param/nky/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find tf_pub)/param/nky/base_local_planner_params.yaml" command="load" />
    <rosparam file="$(find tf_pub)/param/nky/move_base_params.yaml" command="load" />
    <remap from="/cmd_vel" to="raw_cmd_vel"/>
  </node>
</launch>
