

<launch>

    <!-- bag的地址与名称 -->
    <arg name="bag_filename" default="$(find scan_process)/bagfile/s2.bag"/>

    <!-- 使用bag的时间戳 -->
    <param name="use_sim_time" value="true" />

    <!-- 启动节点 -->
    <node name="scan_process_node" pkg="scan_process" type="scan_process_node" output="screen">
      <param name="downsample_resolution" value="0.01" />
      <param name="radius_radius" value="0.10" />
      <param name="radius_min_neighbors" value="1" />	
    </node>
    
    <!-- launch rviz -->    
    <node name="rviz" pkg="rviz" type="rviz" required="false"
        args="-d $(find scan_process)/launch/scan_process_node.rviz" />
	

    <!-- play bagfile -->
    <node name="playbag" pkg="rosbag" type="play"
        args="--clock $(arg bag_filename)" />
    
</launch>
