

<launch>

    <!-- bag的地址与名称 -->
    <arg name="bag_filename" default="$(find scan_process)/bagfile/s2.bag"/>

    <!-- 使用bag的时间戳 -->
    <param name="use_sim_time" value="true" />

    
    <!-- 启动节点 -->
    <node name="lidarodom" pkg="lidarodom" type="lidarodom" output="screen">
      <param name="key_scan_threshold" value="0.55" />
      <param name="loop_detect_dis" value="5.0" />
      <param name="loop_detect_threshold" value="0.5" /> 
      <param name="filepath" value="$(find lidarodom)/outputfile/"/>
    </node>
    
    <!-- launch rviz -->    
    <node name="rviz" pkg="rviz" type="rviz" required="false"
        args="-d $(find lidarodom)/launch/lidarodom.rviz" />
	

    <!-- play bagfile -->
    <node name="playbag" pkg="rosbag" type="play"
        args="--clock $(arg bag_filename)" />

</launch>
